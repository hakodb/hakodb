<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5.0">
    <PathDelim Value="\"/>
    <Name Value="FireLiteDesign"/>
    <Type Value="DesignTime"/>
    <Author Value="FireLite contributors"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <Target>
        <Filename Value="FireLiteDesign"/>
      </Target>
      <SearchPaths>
        <IncludeFiles Value="$(PkgOutDir)"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="FireLite Lazarus design-time package. Registers TFireLiteComponent on the FireLite component palette tab. Requires (and auto-loads) the FireLitePkg runtime package. Install this package into the IDE."/>
    <License Value="MIT"/>
    <Version Major="0" Minor="7" Release="9"/>
    <Files Count="2">
      <Item1>
        <Filename Value="FireLitePkgReg.pas"/>
        <UnitName Value="FireLitePkgReg"/>
        <HasRegisterProc Value="True"/>
      </Item1>
      <Item2>
        <Filename Value="tfirelitecomponent.lrs"/>
      </Item2>
    </Files>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="FireLitePkg"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
