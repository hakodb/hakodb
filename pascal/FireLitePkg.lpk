<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5.0">
    <PathDelim Value="\"/>
    <Name Value="FireLitePkg"/>
    <Type Value="RunTime"/>
    <Author Value="FireLite contributors"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <Target>
        <Filename Value="FireLitePkg"/>
      </Target>
      <SearchPaths>
        <IncludeFiles Value="$(PkgOutDir)"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="FireLite embedded document database bindings for Lazarus (runtime). Raw C-FFI layer (FireLiteRaw), high-level OO engine (FireLite) and drop-on-form component class (TFireLiteComponent). Requires the firelite shared library (firelite.dll / libfirelite.so / libfirelite.dylib). Add as a project requirement to use; install FireLiteDesign.lpk for the component palette."/>
    <License Value="MIT"/>
    <Version Major="0" Minor="7" Release="9"/>
    <Files Count="3">
      <Item1>
        <Filename Value="FireLiteRaw.pas"/>
        <UnitName Value="FireLiteRaw"/>
      </Item1>
      <Item2>
        <Filename Value="FireLite.pas"/>
        <UnitName Value="FireLite"/>
      </Item2>
      <Item3>
        <Filename Value="FireLiteComponent.pas"/>
        <UnitName Value="FireLiteComponent"/>
      </Item3>
    </Files>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="FCL"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
