object Form1: TForm1
  Left = 320
  Height = 420
  Top = 180
  Width = 520
  Caption = 'FireLite Lazarus Demo'
  LCLVersion = '3.4.0'
  object FireLite1: TFireLiteComponent
    DatabasePath = 'demo.db'
    NetSyncPort = 4456
    CloudSyncMode = csmClient
    CloudSyncAddress = 'wss://your-firelite-server'
  end
  object btnRun: TButton
    Left = 16
    Height = 36
    Top = 340
    Width = 128
    Caption = 'Run demo'
    OnClick = btnRunClick
    TabOrder = 1
  end
  object Memo1: TMemo
    Left = 16
    Height = 304
    Top = 16
    Width = 488
    Lines.Strings = (
      'Press "Run demo" to open the database, write a document,'
      'read it back and show engine stats.')
    ScrollBars = ssBoth
    TabOrder = 0
  end
end
